        </mxCell>
        <mxCell id="m_error" value="本次运行失败 / 取消 / 输出检查失败&#xa;记录 process_status.json 并显示错误&#xa;不接受本次结果；留在界面等待操作" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="1" vertex="1">
