        </mxCell>
        <mxCell id="m_inputnote" value="当前输入路径限制&#xa;打开外部 .dat 只更新显示模型；&#xa;非 CAD 求解仍读取根目录 input.dat。&#xa;两者目前未统一绑定。" style="shape=note;size=20;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="1" vertex="1">
