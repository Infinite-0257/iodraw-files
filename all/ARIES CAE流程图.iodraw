  <diagram id="cad" name="02 CAD 建模与求解输入准备">
    <mxGraphModel dx="3565" dy="1938" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="2010" math="0" shadow="0">
      <root>
        <mxCell id="cad_root" />
        <mxCell id="cad_layer" parent="cad_root" />
        <mxCell id="c_title" value="CAD 建模与求解输入准备｜当前实现" style="text;html=0;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;" parent="cad_layer" vertex="1">
          <mxGeometry x="50" y="20" width="1820" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_subtitle" value="左侧：导入、手动 / AI 配置。右侧：点击运行后执行的输入准备。单独生成网格仅更新预览，不等于已完成导出校验。" style="text;html=0;fontSize=14;align=left;fontColor=#64748b;whiteSpace=wrap;" parent="cad_layer" vertex="1">
          <mxGeometry x="50" y="80" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_import" value="建模段入口：用户导入几何" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="220" y="160" width="420" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c_format" value="STEP / STP / BREP？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="255" y="290" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_topology" value="OCCT / CadQuery 导入拓扑&#xa;建立点、边、面数据并显示&#xa;几何改变使依赖状态失效" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="60" y="465" width="390" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c_display" value="IGES / IGS、STL、OBJ、PLY、VTP、VTK&#xa;按现有导入器生成显示几何&#xa;无 CAD 求解所需 topology_model" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="505" y="465" width="410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c_preview" value="返回主界面：几何预览&#xa;当前不能沿 CAD 拓扑路径生成求解网格" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="520" y="625" width="385" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c_settings" value="设置分析、材料、网格、求解器和输出字段&#xa;当前 CAD 分析为静力结构&#xa;载荷 / 约束通过下面两种方式配置" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="60" y="635" width="390" height="105" as="geometry" />
        </mxCell>
        <mxCell id="c_manual" value="手动设置&#xa;选择点 / 边 / 面 → 填写参数 → 应用&#xa;支持固定、位移、力、压力；压力限定面" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="30" y="825" width="405" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_ai" value="AI 辅助设置&#xa;自然语言 → Ollama 或规则解析&#xa;Ollama 失败且启用 fallback 时转规则" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="490" y="825" width="405" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_candidates" value="结构化提案 → 语义目标 → 几何候选&#xa;用户检查参数、补充信息并选择目标" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="490" y="1010" width="405" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_confirm" value="提案完整、目标已选&#xa;且用户确认？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="520" y="1165" width="345" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_assign" value="更新 confirmed_assignments / 命名选区&#xa;绑定 CAD 目标；更新依赖状态" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="220" y="1390" width="540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_return" value="返回主界面等待操作&#xa;可点击「生成网格」或「Run Solver」" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="220" y="1570" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_prepare" value="求解准备段入口&#xa;主流程已确认必要的 AI 提案" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1120" y="160" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_valid" value="求解前校验通过？&#xa;分析、材料、网格、求解器、&#xa;输出、约束 / 载荷与目标" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1170" y="320" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_dirty" value="网格缺失 / 网格参数变化&#xa;或载荷约束配置变化？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1170" y="565" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_mesh" value="Gmsh 生成网格&#xa;重新导入 CAD → 建立实体映射 / Physical Groups&#xa;生成 TET4 / TET10 网格&#xa;写根目录 generated_cad_mesh.msh" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1110" y="800" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c_meshstate" value="更新内存网格、网格请求 / 配置签名&#xa;显示生成的网格" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1110" y="1040" width="490" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c_exportgate" value="导出阶段检查&#xa;配置校验 → 网格质量 → 载荷映射&#xa;任一检查失败即停止导出" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1110" y="1240" width="490" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c_write" value="组装节点约束和等效节点载荷；转换单位&#xa;写 input.dat、input.dat.export_metadata.json&#xa;写 material_properties.dat；重新加载输入网格" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1110" y="1450" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c_done" value="输入准备成功 → 返回主流程启动求解" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1110" y="1710" width="490" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_fail" value="校验 / 网格 / 导出失败&#xa;显示原因并中止本次操作&#xa;用户修正后重新执行" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="1650" y="890" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c_note" value="当前实现边界&#xa;1. CAD 导出路径支持 TET4 / TET10。&#xa;2. 质量与载荷映射检查在导出时执行。&#xa;3. 运行使用非交互导出，缺少 Physical Groups 时阻止。&#xa;4. 单独生成网格不会自动完成 FastFEM 求解。&#xa;5. 通用查询中仍包含支架等特定几何语义。" style="shape=note;size=20;fillColor=#fff2cc;strokeColor=#d6b656;align=left;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="cad_layer" vertex="1">
          <mxGeometry x="50" y="1740" width="800" height="205" as="geometry" />
