        </mxCell>
        <mxCell id="m_cadprep" value="CAD 求解输入准备&#xa;配置校验 → 按需生成网格 → 导出&#xa;详见第 2 页「求解准备段」&#xa;失败则中止本次运行" style="shape=process;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=0;fontSize=15;spacing=8;" parent="1" vertex="1">
